{
  "name": "atelier-girassol",
  "version": "2.0.0",
  "private": true,
  "description": "Atelier Girassol — portfólio de arte com livro ilustrado interativo em 3D, servido por SQLite.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:build": "tsx scripts/db-build.ts",
    "db:seed": "tsx scripts/db-build.ts --force",
    "db:import": "tsx scripts/db-import-book.ts",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "dev": "npm run db:build && next dev",
    "dev:lan": "npm run db:build && next dev -H 0.0.0.0",
    "build": "npm run db:build && next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/three": "^0.186.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
